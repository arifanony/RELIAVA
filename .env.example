# AI SRE — operator environment template (no real secrets in repo)
# AC-8: API keys must be exported in the operator shell and appear in NO repository file.
# Copy nothing — keep this file as-is and export in your shell:
#   export GEMINI_API_KEY=<your key>        # diagnosis default (GOOGLE_API_KEY also accepted)
#   export OPENROUTER_API_KEY=<your key>    # only when a role uses an openrouter: model
# Verify without printing the key:
#   test -n "$GEMINI_API_KEY" && echo ok

# Model routing (defaults per SPEC NFR-4). Each role is a spec:
#   <ROLE>_MODEL=provider:model   provider is gemini, openrouter or ollama;
#   a bare model name means ollama (local). <ROLE>_FAMILY overrides the
#   family derived from the model name; the critic's family must differ
#   from the diagnosis family (FR-5).
# Defaults:
#   DIAGNOSIS_MODEL=gemini:gemini-2.5-flash
#   CRITIC_MODEL=ollama:llama3.2:1b
# Recommended API critic (cross-family, no local model):
#   CRITIC_MODEL=openrouter:<model-id>   # confirm the exact ID in the OpenRouter console
# Local-only operation (no keys, slower):
#   DIAGNOSIS_MODEL=ollama:qwen2.5-coder:7b
# Triage, when wired, follows the same spec form:
#   TRIAGE_MODEL=gemini:gemini-2.5-flash
# DEV_MODEL=qwen2.5-coder:7b
