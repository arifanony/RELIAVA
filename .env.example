# AI SRE — operator environment template (no real secrets in repo)
# AC-8: OPENROUTER_API_KEY must be exported in the operator shell and appear in NO repository file.
# Copy nothing — keep this file as-is and export in your shell:
#   export OPENROUTER_API_KEY='paste-key-here-in-shell-only'
# Verify without printing the key:
#   test -n "$OPENROUTER_API_KEY" && echo ok
OPENROUTER_API_KEY=
